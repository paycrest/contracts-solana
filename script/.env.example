# Deployer / owner keypair, base58-encoded secret key (as printed by
# solana-keygen tooling or Keypair.secretKey via bs58). A JSON byte
# array (e.g. the contents of a solana-keygen file) is also accepted.
DEPLOYER_PRIVATE_KEY=

# Addresses set via `npm run update-addresses`.
TREASURY_ADDRESS=
AGGREGATOR_ADDRESS=

# Optional: override the program id instead of reading it from config.ts
# (useful before the first deploy has written it there).
PROGRAM_ID=

# Optional: override the default public RPC endpoints in config.ts.
SOLANA_MAINNET_RPC_URL=
SOLANA_DEVNET_RPC_URL=
